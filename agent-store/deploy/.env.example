# agent-store Docker Compose 环境变量示例
# 用法：cd agent-store/deploy && cp .env.example .env && vi .env
#
# Versatile Mock 由同事独立部署；本 Compose 仅启动 adapter + edp-agent。
# 请将 VERSATILE_URL 改为同事提供的、adapter 容器内可访问的地址。

# ── 端口映射（宿主机端口，可按需修改）──
EDP_AGENT_PORT=8190
ADAPTER_PORT=8191

# ── LLM（edp-agent 必填）──
EDP_AGENT_MODEL_API_KEY=
EDP_AGENT_MODEL_PROVIDER=OpenAI
EDP_AGENT_MODEL_NAME=deepseek-chat
EDP_AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1

# ── 外部 Versatile REST（adapter 使用，必填）──
# {workflow_id}、{conversation_id} 为运行时占位符，不要替换成具体 ID
# 示例：同事 Mock 映射到宿主机 30001 时，同机部署可用 host.docker.internal
VERSATILE_URL=http://host.docker.internal:30001/v1/0/agent-manager/workflows/{workflow_id}/conversations/{conversation_id}
VERSATILE_WORKFLOW_ID=mock_workflow
VERSATILE_WORKSPACE_ID=10
VERSATILE_RESULT_NODE_TYPE=QA
VERSATILE_RESULT_NODE_NAME=GXZQAResponseNode

# ── edp-agent 直连 Versatile（可选，call_versatile 直连 REST 时使用）──
# 未设置时沿用 deploy/config/edp-agent.yaml 中的默认值
EDP_AGENT_VERSATILE_URL=

# ── MCP 产品列表（edp-agent 内 Python 脚本使用，可选）──
MCP_MASTER_URL=
MCP_STANDBY_URL=
MCP_ACCESS_TOKEN=
MCP_APP_NAME=f-mlp
