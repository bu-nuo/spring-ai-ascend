# ── EDPAgent 环境变量配置 ──
#
# 密钥外部化说明：
# edp-agent.yaml 通过 Jackson 直读加载，不支持 Spring Boot ${...} 占位符替换。
# 密钥类配置（apiKey）通过环境变量在 Bean 创建阶段注入，YAML 中写 PLACEHOLDER_USE_ENV_VAR 占位。
# 非密钥类配置（versatile.url、model.provider、model.name 等）直接硬编码在 YAML 中。
# 环境变量可覆盖 YAML 中的硬编码值。
#
# 场景路径说明（方案 B）：
# scenarioHome 由 Spring Boot @Value 注入（edpa.agent.scenario-home），
# 默认值为 ../scenarios/wealth-demo（相对于 engine/ 目录）。
# 切换场景只需设置 EDP_AGENT_SCENARIO_HOME 为目标场景目录路径。

# ── LLM 模型密钥（必填） ──
EDP_AGENT_MODEL_API_KEY=your-api-key-here

# ── LLM 模型配置（可选覆盖，YAML 中已有硬编码默认值） ──
EDP_AGENT_MODEL_PROVIDER=OpenAI
EDP_AGENT_MODEL_NAME=deepseek-v4-pro
EDP_AGENT_MODEL_BASE_URL=https://api.deepseek.com/v1

# ── Versatile 工作流服务（可选覆盖，YAML 中已有硬编码默认值） ──
EDP_AGENT_VERSATILE_URL=http://localhost:30001/v1/0/agent-manager/workflows/{workflow_id}/conversations/{conversation_id}

# ── 场景路径（可选覆盖，默认 ../scenarios/wealth-demo） ──
# 切换场景示例：
#   EDP_AGENT_SCENARIO_HOME=../scenarios/hz-zhidaitong
#   或绝对路径：
#   EDP_AGENT_SCENARIO_HOME=D:/myproject/java/edpa/scenarios/hz-zhidaitong
EDP_AGENT_SCENARIO_HOME=../scenarios/wealth-demo

# ── 日志配置 ──
EDP_AGENT_LOG_LEVEL=INFO
